# docker compose loads this file automatically after copying it to .env.
POSTGRES_DB=photosync
POSTGRES_USER=photosync
# Set a private password; use URL-safe characters (e.g. random hex).
POSTGRES_PASSWORD=
SERVER_PORT=3000
LOG_LEVEL=info
DATABASE_TIMEOUT_MS=2000
# Host paths: separate existing directories; never share dev/prod data.
PHOTOSYNC_DEV_MEDIA_PATH=./.local/media
PHOTOSYNC_PROD_MEDIA_PATH=/mnt/photosync/media

# Blank disables instance setup. Store only the hash printed by setup:token here.
SETUP_TOKEN_HASH=
PAIRING_CODE_TTL_SECONDS=600
AUTH_RATE_LIMIT_MAX=10
MAX_UPLOAD_BYTES=1073741824
DERIVATIVE_WORKER_ENABLED=true
DERIVATIVE_POLL_INTERVAL_MS=1000
DERIVATIVE_MAX_ATTEMPTS=5
DERIVATIVE_TOOL_TIMEOUT_MS=600000
