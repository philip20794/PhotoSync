[Unit]
Description=PhotoSync production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/photosync-storage/photosync/production
ConditionPathExists=/srv/photosync-storage/photosync/production/config/production.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/philip/PhotoSync
EnvironmentFile=/srv/photosync-storage/photosync/production/config/production.env
ExecStartPre=/home/philip/PhotoSync/ops/verify-production-storage.sh
ExecStart=/usr/bin/docker compose --env-file /srv/photosync-storage/photosync/production/config/production.env -f /home/philip/PhotoSync/compose.yaml -f /home/philip/PhotoSync/compose.production.yaml up -d --wait
ExecStop=/usr/bin/docker compose --env-file /srv/photosync-storage/photosync/production/config/production.env -f /home/philip/PhotoSync/compose.yaml -f /home/philip/PhotoSync/compose.production.yaml down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
