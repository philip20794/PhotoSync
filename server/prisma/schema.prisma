generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Technical migration baseline.
model ServiceMetadata {
  key   String @id @db.VarChar(64)
  value String @db.VarChar(255)

  @@map("service_metadata")
}

model Pair {
  id               String    @id @default(uuid()) @db.Uuid
  singleton        Int       @unique @default(1)
  setupCompletedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  users            User[]
  pairingCodes     PairingCode[]

  @@map("pairs")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  pairId       String   @db.Uuid
  memberSlot   Int
  displayName  String   @db.VarChar(80)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  pair         Pair     @relation(fields: [pairId], references: [id], onDelete: Restrict)
  devices      Device[]
  pairingCodes PairingCode[]
  albums       Album[]
  assets       Asset[]

  @@unique([pairId, memberSlot])
  @@map("users")
}

model Device {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  name          String    @db.VarChar(80)
  tokenHash     String?   @unique @db.Char(64)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  pairingCodes  PairingCode[]
  sourceAlbums  Album[]
  syncPush      SyncPushDevice?

  @@unique([id, userId])
  @@index([userId])
  @@map("devices")
}

model PairingCode {
  id                String    @id @default(uuid()) @db.Uuid
  pairId            String    @db.Uuid
  createdByDeviceId String    @db.Uuid
  targetUserId      String?   @db.Uuid
  purpose           String    @db.VarChar(16)
  codeHash          String    @unique @db.Char(64)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  consumedAt        DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  pair              Pair      @relation(fields: [pairId], references: [id], onDelete: Restrict)
  createdByDevice   Device    @relation(fields: [createdByDeviceId], references: [id], onDelete: Restrict)
  targetUser        User?     @relation(fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([createdByDeviceId])
  @@index([expiresAt])
  @@map("pairing_codes")
}

// Trigger-maintained journal. No media foreign keys: deletion invalidations survive.
model SyncHead {
  id       Int    @id
  epoch    String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision BigInt @default(0)
  minRevision BigInt @default(0)
  @@map("sync_head")
}

model SyncChange {
  revision BigInt @id
  pairId String @db.Uuid
  ownerId String @db.Uuid
  albumId String @db.Uuid
  assetId String? @db.Uuid
  kind String
  operation String
  shared Boolean
  createdAt DateTime @default(now()) @db.Timestamptz
  @@index([pairId, revision], map: "sync_changes_pair_revision")
  @@map("sync_changes")
}

model SyncPushDevice {
  deviceId String @id @db.Uuid
  token String @unique
  revision BigInt @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz
  attempts Int @default(0)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@map("sync_push_devices")
}

model Album {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  sourceDeviceId String   @db.Uuid
  clientAlbumId  String   @db.VarChar(255)
  title          String   @db.VarChar(200)
  sharedAt       DateTime? @db.Timestamptz(3)
  backedUpAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceDevice   Device   @relation(fields: [sourceDeviceId, ownerId], references: [id, userId], onDelete: Restrict)
  assets         Asset[]

  @@unique([sourceDeviceId, clientAlbumId])
  @@unique([id, ownerId])
  @@index([ownerId])
  @@map("albums")
}

model Asset {
  id               String    @id @default(uuid()) @db.Uuid
  ownerId          String    @db.Uuid
  albumId          String    @db.Uuid
  originalFileName String    @db.VarChar(255)
  mimeType         String    @db.VarChar(127)
  capturedAt       DateTime? @db.Timestamptz(3)
  fileSize         BigInt
  width            Int
  height           Int
  durationMillis   BigInt?
  sourceDeviceId   String?   @db.Uuid
  clientAssetId    String?   @db.VarChar(255)
  expectedSha256   String?   @db.Char(64)
  sha256           String?   @db.Char(64)
  integrityStatus  String    @default("healthy") @db.VarChar(16)
  integrityError   String?   @db.VarChar(500)
  integrityCheckedAt DateTime? @db.Timestamptz(3)
  storagePath      String    @unique @db.VarChar(512)
  status           String    @default("pending") @db.VarChar(16)
  uploadStartedAt  DateTime? @db.Timestamptz(3)
  uploadLeaseId    String?   @db.Uuid
  uploadLeaseExpiresAt DateTime? @db.Timestamptz(3)
  uploadSessionId  String?   @unique @db.Uuid
  uploadOffset     BigInt    @default(0)
  uploadPartPath   String?   @unique @db.VarChar(512)
  uploadExpiresAt  DateTime? @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)
  purgeAfter       DateTime? @db.Timestamptz(3)
  cleanupRequestedAt DateTime? @db.Timestamptz(3)
  cleanupAttempts  Int       @default(0)
  cleanupLastError String?   @db.VarChar(500)
  cleanupLeaseId   String?   @db.Uuid
  cleanupLeaseExpiresAt DateTime? @db.Timestamptz(3)
  purgedAt         DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  album            Album     @relation(fields: [albumId, ownerId], references: [id, ownerId], onDelete: Restrict)
  derivatives      AssetDerivative[]

  @@unique([sourceDeviceId, clientAssetId])
  @@unique([albumId, expectedSha256])
  @@index([ownerId])
  @@index([albumId, createdAt])
  @@index([status, uploadLeaseExpiresAt], map: "assets_upload_recovery_idx")
  @@index([status, purgeAfter], map: "assets_trash_purge_idx")
  @@index([status, cleanupLeaseExpiresAt], map: "assets_trash_recovery_idx")
  @@map("assets")
}


model AssetDerivative {
  id             String   @id @default(uuid()) @db.Uuid
  assetId        String   @db.Uuid
  kind           String   @db.VarChar(16)
  status         String   @default("pending") @db.VarChar(16)
  mimeType       String?  @db.VarChar(127)
  storagePath    String?  @unique @db.VarChar(512)
  fileSize       BigInt?
  width          Int?
  height         Int?
  durationMillis BigInt?
  sha256         String?  @db.Char(64)
  attempts       Int      @default(0)
  lastError      String?  @db.VarChar(500)
  nextAttemptAt  DateTime @default(now()) @db.Timestamptz(3)
  processingLeaseId String? @db.Uuid
  processingLeaseExpiresAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind])
  @@index([status, nextAttemptAt])
  @@index([status, processingLeaseExpiresAt], map: "asset_derivatives_recovery_idx")
  @@map("asset_derivatives")
}
