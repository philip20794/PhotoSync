# Optional host execution, from server/: node --env-file=.env dist/index.js
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_TIMEOUT_MS=2000
# Requires a separately reachable PostgreSQL instance; Compose DB has no host port.
DATABASE_URL=postgresql://photosync:CHANGE_ME@127.0.0.1:5432/photosync
MEDIA_DEV_ROOT=/absolute/path/to/PhotoSync/.local/media
MEDIA_PROD_ROOT=/srv/photosync-storage/photosync/production/media

# Blank disables instance setup. Store only the hash printed by setup:token here.
SETUP_TOKEN_HASH=
PAIRING_CODE_TTL_SECONDS=600
AUTH_RATE_LIMIT_MAX=10
MAX_UPLOAD_BYTES=1073741824
API_REQUEST_TIMEOUT_MS=10000
UPLOAD_REQUEST_TIMEOUT_MS=3600000
UPLOAD_LEASE_MS=120000
UPLOAD_RECOVERY_INTERVAL_MS=30000
UPLOAD_SESSION_TTL_MS=604800000
MAX_UPLOAD_CHUNK_BYTES=8388608
DERIVATIVE_WORKER_ENABLED=true
DERIVATIVE_POLL_INTERVAL_MS=1000
DERIVATIVE_MAX_ATTEMPTS=5
DERIVATIVE_TOOL_TIMEOUT_MS=600000
DERIVATIVE_BACKLOG_WARNING=100
# Optional fast wake-up only. Requires Application Default Credentials.
FCM_ENABLED=false
SYNC_CHANGE_RETENTION_DAYS=90
